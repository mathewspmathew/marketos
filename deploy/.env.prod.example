# Copy to .env on the VM (chmod 600, never commit). Same variables as
# the local .env.example (if present) plus two production-only additions
# at the bottom for the Cloudflare Tunnel and the public app URL.

DATABASE_URL=
# DATABASE_URL above: only used by host-run/one-off processes on the VM
# (e.g. ad-hoc psql). Every service in docker-compose.prod.yml actually gets
# its DATABASE_URL from PGBOUNCER_DATABASE_URL below instead.
# DIRECT_DATABASE_URL: same Aiven target as DATABASE_URL, explicit alias for
# the two paths that must bypass PgBouncer — live_updates.py's LISTEN/NOTIFY
# connection (session-scoped, incompatible with transaction pooling) and
# Prisma Migrate's directUrl (its schema engine doesn't support a pooler).
DIRECT_DATABASE_URL=
# PGBOUNCER_UPSTREAM_URL: same Aiven target again, no query string — PgBouncer's
# own config parser can't handle e.g. "?sslmode=require" in the database-name
# slot; TLS to Aiven is set separately via docker-compose.prod.yml's pgbouncer
# service (SERVER_TLS_SSLMODE=require).
PGBOUNCER_UPSTREAM_URL=
# PGBOUNCER_DATABASE_URL: what every service actually uses as DATABASE_URL —
# routes through this VM's own pgbouncer container. Local dev and this
# production stack share the same Aiven instance, each running its own
# separate PgBouncer against it (see docker-compose.yml's pgbouncer service
# for the connection-budget reasoning behind DEFAULT_POOL_SIZE=8 on both sides).
PGBOUNCER_DATABASE_URL=
REDIS_URL=redis://redis:6379/0

FIRECRAWL_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_CANDIDATE=
GROQ_API_KEY_SEMANTIC=
GROQ_API_KEY_SHOPIFY=
GROQ_API_KEY_CHATBOT=
SERPER_API_KEY=

# GCS_*/VERTEX_PROJECT: must be the GCP project currently in use — check the
# local dev .env for the current values before copying, GCP projects get
# migrated when a billing account goes delinquent (has happened before).
GCS_IMAGE_BUCKET=
GCS_MARKDOWN_BUCKET=

VERTEX_PROJECT=
VERTEX_LOCATION=
# Personal-account ADC, not a service account key — this project's org policy
# (constraints/iam.disableServiceAccountKeyCreation) blocks minting service
# account keys. On the VM: `gcloud auth login <account>` then
# `gcloud auth application-default login` then
# `gcloud auth application-default set-quota-project <VERTEX_PROJECT value>`
# (same three commands used for local dev) — this file must exist at exactly
# this path before the stack starts.
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
INTERNAL_API_TOKEN=

CHATBOT_MODEL=groq:llama-3.3-70b-versatile
CHATBOT_FALLBACK_MODEL=groq:openai/gpt-oss-120b,groq:llama-3.1-8b-instant
LOGFIRE_TOKEN=

MARKETOS_DEMO_TENANT_ID=

# Production-only:
SHOPIFY_APP_URL=https://<YOUR_DOMAIN>
CLOUDFLARE_TUNNEL_TOKEN=
