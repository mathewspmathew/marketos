# Copy to .env on the VM (chmod 600, never commit). Same variables as
# the local .env.example (if present) plus two production-only additions
# at the bottom for the Cloudflare Tunnel and the public app URL.

DATABASE_URL=
REDIS_URL=redis://redis:6379/0

FIRECRAWL_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_CANDIDATE=
GROQ_API_KEY_SEMANTIC=
GROQ_API_KEY_SHOPIFY=
GROQ_API_KEY_CHATBOT=
SERPER_API_KEY=

GCS_IMAGE_BUCKET=
GCS_MARKDOWN_BUCKET=

VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
INTERNAL_API_TOKEN=

CHATBOT_MODEL=groq:llama-3.3-70b-versatile
CHATBOT_FALLBACK_MODEL=groq:openai/gpt-oss-120b,groq:llama-3.1-8b-instant
LOGFIRE_TOKEN=

MARKETOS_DEMO_TENANT_ID=

# Production-only:
SHOPIFY_APP_URL=https://<YOUR_DOMAIN>
CLOUDFLARE_TUNNEL_TOKEN=
