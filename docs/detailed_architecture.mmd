%% Clients
User(["End User (Browser)"]):::clsClient
ShopifyFrontend["Shopify UI<br>(Remix / React)"]:::clsClient

%% API Gateway
Gateway["api_gateway/main.py<br>(FastAPI + Uvicorn)"]:::clsApi

%% -------------------------
%% Synchronous Layer
%% -------------------------
subgraph SyncLayer["Synchronous Layer"]
direction TB

subgraph ChatbotSvc["chatbot_svc"]
direction TB

ChatbotApp["app.py<br>(FastAPI + SSE)"]:::clsModule
ChatbotAgent["agent.py<br>(Pydantic-AI)"]:::clsModule
ChatbotTools["tools/<br>(query_studio, ask)"]:::clsModule
ChatbotContext["context.py<br>sessions.py"]:::clsModule

ChatbotApp --> ChatbotAgent
ChatbotAgent --> ChatbotTools
ChatbotApp --> ChatbotContext

end

PricingSvc["pricing_svc<br>(Dynamic Pricing)"]:::clsModule
DiscoverySvc["discovery_svc<br>(Product Matching)"]:::clsModule

end

%% -------------------------
%% Async Pipeline
%% -------------------------
subgraph AsyncPipeline["Asynchronous Pipeline"]
direction TB

Redis[("Redis Message Broker")]:::clsData
CeleryBeat(("celery_beat.py<br>Scheduler")):::clsWorker

subgraph ScraperSvc["Scraper Celery Workers"]
direction TB

Semantics["semantics.py"]:::clsWorker
CandidateGen["candidate.py"]:::clsWorker
ScraperModule["scraper.py<br>(Firecrawl)"]:::clsWorker
Extractor["extractor.py<br>(LLM Extraction)"]:::clsWorker
UrlClassifier["url_classifier.py"]:::clsWorker

Semantics --> CandidateGen
CandidateGen --> ScraperModule
ScraperModule --> Extractor
ScraperModule --> UrlClassifier

end

subgraph EmbeddingSvc["Embedding Celery Workers"]

EmbeddingModule["main.py<br>(Vertex AI Embeddings)"]:::clsWorker

end

