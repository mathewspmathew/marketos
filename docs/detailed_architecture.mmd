subgraph CommonLibrary["services/common/"]
direction TB

DbModule["db.py<br>(SQLAlchemy Pool)"]:::clsCommon
ModelsModule["models.py<br>(ORM Models)"]:::clsCommon
CeleryApp["celery_app.py"]:::clsCommon
GroqClient["groq_client.py"]:::clsCommon
VertexEmbed["vertex_embed.py"]:::clsCommon
GcsUtils["gcs_utils.py"]:::clsCommon
