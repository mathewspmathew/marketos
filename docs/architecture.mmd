flowchart TD
    %% Define Styles
    classDef clsClient fill:#f8f9fa,stroke:#495057,stroke-width:2px,color:#212529
    classDef clsUi fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1565c0
    classDef clsGateway fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#e65100
    classDef clsSync fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#4a148c
    classDef clsAsync fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#2e7d32
    classDef clsExt fill:#fffde7,stroke:#f57f17,stroke-width:2px,color:#f57f17
    classDef clsDb fill:#eceff1,stroke:#37474f,stroke-width:2px,color:#37474f

    %% Clients & UI
    User(["User Browser"]):::clsClient
    ShopifyUI["Shopify UI<br/>(Node.js / React Router)"]:::clsUi

    %% External APIs
    subgraph "External Dependencies"
        ShopifyAPI(["Shopify Admin API"]):::clsExt
        Firecrawl(["Firecrawl API"]):::clsExt
        Groq(["Groq AI API"]):::clsExt
        VertexAI(["Google Vertex AI"]):::clsExt
    end

    %% Gateway
    Gateway(["API Gateway<br/>(FastAPI / Uvicorn)"]):::clsGateway

    %% Synchronous Services
    subgraph "Synchronous Microservices"
        direction TB

        Chatbot["Chatbot Service<br/>(FastAPI / Pydantic-AI)<br/>Endpoints:<br/>• POST /chat (SSE)<br/>• POST /query-studio"]:::clsSync

        Pricing["Pricing Service<br/>(FastAPI)"]:::clsSync
        Discovery["Discovery Service"]:::clsSync
        Matcher["Matcher Service"]:::clsSync
    end

    %% Asynchronous Pipeline
    subgraph "Asynchronous Pipeline"
        direction TB

        Redis[("Redis Broker")]:::clsDb
        Beat(("Celery Beat<br/>Scheduler")):::clsAsync

        Scraper["Scraper Service<br/>(Celery Workers)<br/>python-dotenv"]:::clsAsync

        Embedding["Embedding Service<br/>(Celery Workers)"]:::clsAsync
    end

    %% Infrastructure
    subgraph Infrastructure
        Guardian{"Guardian Service<br/>(Security/Auth)"}
        Obs{"Observability"}
    end

    %% Database Layer
    Common[["Common Module<br/>(SQLAlchemy / psycopg3)"]]:::clsDb
    DB[("Aiven Database<br/>PostgreSQL")]:::clsDb

    %% Relationships
    User -->|Interacts| ShopifyUI

    ShopifyUI -->|Webhooks / API Calls| ShopifyAPI
    ShopifyAPI -->|Responses| ShopifyUI

    ShopifyUI -->|"Internal HTTP Calls<br/>POST /internal/shopify/product-updated<br/>POST /internal/shopify/sync-products"| Gateway

    Gateway -->|Routes traffic| Chatbot
    Gateway -->|Routes traffic| Pricing
    Gateway -->|Routes traffic| Discovery
    Gateway -->|Routes traffic| Matcher

    Gateway -.->|Enqueues Tasks| Redis
    Beat -.->|Schedules Tasks| Redis

    Redis -->|Consumed by| Scraper
    Redis -->|Consumed by| Embedding

    Scraper -->|Web Scraping| Firecrawl
    Scraper -->|LLM Extraction| Groq
    Embedding -->|Generates Embeddings| VertexAI

    Chatbot --> Common
    Pricing --> Common
    Scraper --> Common
    Embedding --> Common
    Gateway --> Common

    Common --> DB

    Gateway -.-> Guardian
    Gateway -.-> Obs