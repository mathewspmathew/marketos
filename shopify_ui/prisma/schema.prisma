// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─────────────────────────────────────────
// Multi-Tenancy (keyed by Shopify shop domain)
// ─────────────────────────────────────────
model ShopifyUser {
  shopDomain    String   @id
  shopifyUserId BigInt?
  email         String?
  firstName     String?
  installedAt   DateTime @default(now())

  products          ShopifyProduct[]
  scrapedProducts   ScrapedProduct[]
  scrapingConfigs   ScrapingConfig[]
  scrapingErrors    ScrapingError[]
  productUrls       ProductUrl[]
  productEmbeddings ProductEmbedding[]
  productMatches    ProductMatch[]

  competitors            Competitor[]
  competitorObservations CompetitorPriceObservation[]
  productLevelMatches    ProductLevelMatch[]
  pricingRules           PricingRule[]
  pricingConfig          PricingConfig?
  priceDecisions         PriceDecision[]
  promotionWindows       PromotionWindow[]
  shopAuth               ShopAuth?
}

// ─────────────────────────────────────────
// INTERNAL: Shopify Store Data
// ─────────────────────────────────────────
model ShopifyProduct {
  id         String      @id // Shopify GID
  shopDomain String
  shop       ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])

  title       String
  description String  @default("")
  vendor      String?
  productType String  @default("")
  tags        Json    @default("[]")
  imageUrl    String?
  handle      String?
  status      String  @default("ACTIVE")

  // Parsed from the structured semanticText fingerprint. Used by the matcher
  // SQL pre-filter as a hard gate before HNSW similarity is computed.
  categoryTop   String? // e.g. "clothing", "electronics", "kitchenware"
  productGender String? // men / women / unisex / kids / not-applicable

  dynamicPricingEnabled Boolean   @default(false)
  syncPrice             Boolean   @default(true)
  syncDescription       Boolean   @default(false)
  syncTitle             Boolean   @default(false)
  syncedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants            ShopifyVariant[]
  suggestion          ProductSuggestion?
  productLevelMatches ProductLevelMatch[]
}

model ShopifyVariant {
  id        String         @id
  productId String
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku      String?
  barcode  String?
  title    String  @default("Default Title")
  options  Json?
  imageUrl String?

  currentPrice      Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  cost              Decimal? @db.Decimal(10, 2)
  isInStock         Boolean  @default(true)
  stockQuantity     Int?
  inventoryQuantity Int?
  autoPriceEnabled  Boolean  @default(false)
  useMlSuggestion   Boolean  @default(false)
  semanticText      String?

  updatedAt DateTime @updatedAt

  embedding       ShopifyEmbedding?
  productMatches  ProductMatch[]
  competitorStats VariantCompetitorStats?
  priceDecisions  PriceDecision[]
  salesAggregate  SalesAggregate?
}

model ShopifyEmbedding {
  id         String         @id @default(uuid())
  variantId  String         @unique
  variant    ShopifyVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  shopDomain String

  vectorText Unsupported("vector(768)")?
  vectorImg  Unsupported("vector(1408)")?

  embeddedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  matchedAt  DateTime?

  @@index([shopDomain])
}

// ─────────────────────────────────────────
// COMPETITOR: Scraped External Data
// ─────────────────────────────────────────
model ScrapedProduct {
  id         String      @id @default(uuid())
  shopDomain String
  shop       ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])
  domain     String

  title          String
  description    String?
  vendor         String?
  productType    String?
  tags           Json    @default("[]")
  imageUrl       String?
  specifications Json?

  // Parsed from the structured semanticText fingerprint. Used by the matcher
  // SQL pre-filter as a hard gate before HNSW similarity is computed.
  categoryTop   String? // e.g. "clothing", "electronics", "kitchenware"
  productGender String? // men / women / unisex / kids / not-applicable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants            ScrapedVariant[]
  urls                ProductUrl[]
  embeddings          ProductEmbedding[]
  productMatches      ProductMatch[]
  productLevelMatches ProductLevelMatch[]
}

model ScrapedVariant {
  id        String         @id @default(uuid())
  productId String
  product   ScrapedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String?
  barcode       String?
  title         String   @default("Default Title")
  options       Json?
  currentPrice  Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("INR") @db.VarChar(3)
  isInStock     Boolean  @default(true)
  stockQuantity Int?
  semanticText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embeddings     ProductEmbedding[]
  productMatches ProductMatch[]
  observations   CompetitorPriceObservation[]
}

// ─────────────────────────────────────────
// URL TRACKING
// ─────────────────────────────────────────
enum UrlStatus {
  ACTIVE
  DEAD
  PAUSED
}

model ProductUrl {
  id         String         @id @default(uuid())
  shopDomain String
  shop       ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  configId   String
  config     ScrapingConfig @relation(fields: [configId], references: [id])
  prodId     String
  product    ScrapedProduct @relation(fields: [prodId], references: [id], onDelete: Cascade)

  url           String    @unique
  status        UrlStatus @default(ACTIVE)
  failCount     Int       @default(0)
  lastScrapedAt DateTime?
  nextScrapAt   DateTime?
  createdAt     DateTime  @default(now())
}

// ─────────────────────────────────────────
// EMBEDDINGS
// ─────────────────────────────────────────
model ProductEmbedding {
  id         String  @id @default(uuid())
  shopDomain String
  prodId     String
  variantId  String?

  vectorText   Unsupported("vector(768)")?
  vectorImg    Unsupported("vector(1408)")?
  vectorizedAt DateTime                     @default(now())
  matchedAt    DateTime?

  shop    ShopifyUser     @relation(fields: [shopDomain], references: [shopDomain])
  product ScrapedProduct  @relation(fields: [prodId], references: [id], onDelete: Cascade)
  variant ScrapedVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────
// SCRAPER CONFIGS
// ─────────────────────────────────────────
enum ScrapeStatus {
  IDLE
  QUEUED
  RUNNING
  SCRAPED_FIRST
}

model ScrapingConfig {
  id                String       @id @default(uuid())
  shopDomain        String
  shop              ShopifyUser  @relation(fields: [shopDomain], references: [shopDomain])
  competitorUrl     String
  includeImages     Boolean      @default(true)
  productLimit      Int?
  frequencyInterval Int?
  frequencyUnit     String?      @default("nofreq")
  nextRunAt         DateTime?
  isActive          Boolean      @default(true)
  status            ScrapeStatus @default(IDLE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  productUrls    ProductUrl[]
  scrapingErrors ScrapingError[]
}

// ─────────────────────────────────────────
// SCRAPING ERRORS
// ─────────────────────────────────────────
model ScrapingError {
  id          String         @id @default(uuid())
  shopDomain  String
  shop        ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  configId    String
  config      ScrapingConfig @relation(fields: [configId], references: [id])
  productUrl  String
  gcsRef      String?
  errorType   String
  errorDetail String?
  taskName    String
  failedAt    DateTime       @default(now())
}

// ─────────────────────────────────────────
// SIMILARITY MATCHES (merchant variant ↔ competitor variant)
// ─────────────────────────────────────────
// variant level matching
model ProductMatch {
  id                  String          @id @default(uuid())
  shopDomain          String
  shop                ShopifyUser     @relation(fields: [shopDomain], references: [shopDomain])
  shopifyVariantId    String
  shopifyVariant      ShopifyVariant  @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)
  competitorVariantId String?
  competitorVariant   ScrapedVariant? @relation(fields: [competitorVariantId], references: [id], onDelete: SetNull)
  competitorProdId    String
  competitorProduct   ScrapedProduct  @relation(fields: [competitorProdId], references: [id], onDelete: Cascade)

  matchScore     Decimal  @db.Decimal(5, 2)
  textScore      Decimal? @db.Decimal(5, 2)
  imageScore     Decimal? @db.Decimal(5, 2)
  matchType      String   @default("semantic")
  vectorDistance Decimal  @db.Decimal(10, 6)
  thresholdUsed  Decimal  @db.Decimal(5, 4)

  confidence     Decimal?             @db.Decimal(4, 3)
  confidenceTier MatchConfidenceTier?
  productMatchId String?
  productMatch   ProductLevelMatch?   @relation(fields: [productMatchId], references: [id], onDelete: SetNull)

  matchedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dismissedAt DateTime?

  @@unique([shopifyVariantId, competitorVariantId])
  @@index([shopifyVariantId, matchScore(sort: Desc)], map: "idx_pm_shopify")
  @@index([competitorVariantId], map: "idx_pm_competitor")
  @@index([shopDomain, matchScore(sort: Desc)], map: "idx_pm_shop_domain")
  @@index([shopDomain, dismissedAt], map: "idx_pm_shop_dismissed")
}

// ─────────────────────────────────────────
// PRODUCT SUGGESTIONS (LLM-generated title/description + competitor price stats)
// ─────────────────────────────────────────
enum SuggestionStatus {
  FIRST_TIME
  SHOWED
  SKIPPED
  APPLIED
}

model ProductSuggestion {
  id               String         @id @default(uuid())
  shopDomain       String
  shopifyProductId String         @unique
  product          ShopifyProduct @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)

  suggestedTitle           String?
  suggestedDescriptionHtml String?
  contentRationale         String?

  editedTitle           String?
  editedDescriptionHtml String?

  appliedTitle           String?
  appliedDescriptionHtml String?

  matchCount    Int      @default(0)
  avgMatchScore Decimal? @db.Decimal(5, 2)

  status      SuggestionStatus @default(FIRST_TIME)
  generatedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  appliedAt   DateTime?

  @@index([shopDomain, status])
}

// ─────────────────────────────────────────
// DYNAMIC PRICING — competitors, observations, stats
// ─────────────────────────────────────────
enum CompetitorTier {
  PREMIUM
  MIDMARKET
  BUDGET
}

enum MatchConfidenceTier {
  CONFIRMED
  LIKELY
  WEAK
}

// for entering just the competitor details only
model Competitor {
  id          String         @id @default(uuid())
  shopDomain  String
  shop        ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  domain      String
  displayName String?
  tier        CompetitorTier @default(MIDMARKET)
  weight      Decimal        @default(0.5) @db.Decimal(3, 2)
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  observations CompetitorPriceObservation[]

  @@unique([shopDomain, domain])
  @@index([shopDomain, enabled])
}

// Hypertable on observedAt (created via raw SQL after migration).
model CompetitorPriceObservation {
  id                  String         @id @default(uuid())
  shopDomain          String
  shop                ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  competitorId        String?
  competitor          Competitor?    @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  competitorVariantId String
  competitorVariant   ScrapedVariant @relation(fields: [competitorVariantId], references: [id], onDelete: Cascade)
  price               Decimal        @db.Decimal(10, 2)
  currency            String         @default("INR") @db.VarChar(3)
  isInStock           Boolean        @default(true)
  observedAt          DateTime       @default(now())

  @@index([competitorVariantId, observedAt(sort: Desc)])
  @@index([shopDomain, observedAt(sort: Desc)])
}


// this table is for Shopify products where it saves the stats of merchant's shopify products
model VariantCompetitorStats {
  shopifyVariantId String         @id
  variant          ShopifyVariant @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)
  shopDomain       String

  competitorCount    Int      @default(0)
  minPrice           Decimal? @db.Decimal(10, 2)
  p25                Decimal? @db.Decimal(10, 2)
  median             Decimal? @db.Decimal(10, 2)
  p75                Decimal? @db.Decimal(10, 2)
  maxPrice           Decimal? @db.Decimal(10, 2)
  weightedMin        Decimal? @db.Decimal(10, 2)
  weightedMedian     Decimal? @db.Decimal(10, 2)
  volatility24h      Decimal? @db.Decimal(6, 4)
  avgMatchConfidence Decimal? @db.Decimal(4, 3)
  lastUpdatedAt      DateTime @default(now())

  @@index([shopDomain])
}

// from ProductMatch data is taken - Product level matching - matched with max(variant_confidence) - best variant for a product

model ProductLevelMatch {
  id               String         @id @default(uuid())
  shopDomain       String
  shop             ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  shopifyProductId String
  shopifyProduct   ShopifyProduct @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)
  scrapedProductId String
  scrapedProduct   ScrapedProduct @relation(fields: [scrapedProductId], references: [id], onDelete: Cascade)

  confidence          Decimal             @db.Decimal(4, 3)
  confidenceTier      MatchConfidenceTier
  source              String              @default("RERANKER") // ANN | RERANKER | MANUAL
  confirmedByMerchant Boolean             @default(false)
  rejectedByMerchant  Boolean             @default(false)
  reviewedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantMatches ProductMatch[]

  @@unique([shopifyProductId, scrapedProductId])
  @@index([shopDomain, confidenceTier])
  @@index([shopDomain, reviewedAt])
}

// ─────────────────────────────────────────
// DYNAMIC PRICING — rules, decisions, audit
// ─────────────────────────────────────────
enum PricingRuleScope {
  SHOP
  COLLECTION
  TAG
  PRODUCT
  VARIANT
}

enum PricingRuleType {
  MATCH_LOWEST
  BEAT_BY_PCT
  STAY_ABOVE_COST_PCT
  MATCH_TIER_LOWEST
}

model PricingRule {
  id         String      @id @default(uuid())
  shopDomain String
  shop       ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])

  scope    PricingRuleScope @default(SHOP)
  scopeRef String? // collection id / tag / product id / variant id; null for SHOP

  ruleType PricingRuleType
  params   Json            @default("{}")

  floorPrice          Decimal? @db.Decimal(10, 2)
  ceilingPrice        Decimal? @db.Decimal(10, 2)
  maxDailyDeltaPct    Decimal? @db.Decimal(5, 2)
  tierFilter          String[]
  maxStalenessSeconds Int      @default(86400)

  autoApply     Boolean @default(false)
  mlBlendWeight Decimal @default(0.0) @db.Decimal(3, 2)
  priority      Int     @default(100)
  enabled       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions PriceDecision[]

  @@index([shopDomain, enabled, priority])
  @@index([shopDomain, scope, scopeRef])
}

model PricingConfig {
  shopDomain String      @id
  shop       ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])

  sparseNudgeAmplitude Decimal @default(0.02) @db.Decimal(4, 3)
  hotVelocityRatio     Decimal @default(1.3) @db.Decimal(4, 2)
  coolVelocityRatio    Decimal @default(0.7) @db.Decimal(4, 2)
  lowStockDays         Int     @default(7)
  highStockDays        Int     @default(90)
  killSwitch           Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model PriceDecision {
  id               String         @id @default(uuid())
  shopDomain       String
  shop             ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  shopifyVariantId String
  variant          ShopifyVariant @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)
  ruleId           String?
  rule             PricingRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  oldPrice           Decimal  @db.Decimal(10, 2)
  newPrice           Decimal  @db.Decimal(10, 2)
  ruleSuggestedPrice Decimal? @db.Decimal(10, 2)
  mlSuggestedPrice   Decimal? @db.Decimal(10, 2)
  mlConfidence       Decimal? @db.Decimal(4, 3)
  modelVersion       String?
  reason             String
  blockedBy          String?
  confidence         Decimal? @db.Decimal(4, 3)
  statsSnapshot      Json?
  signalsSnapshot    Json?

  // Folded from PriceChange: outcome of the Shopify write attempt.
  shopifyResponse Json?
  revertedAt      DateTime?

  // Folded from PricingAlert: a non-null alertReason means this decision
  // surfaces in the alerts feed. Severity is INFO | WARN | CRITICAL.
  alertReason     String?
  alertSeverity   String?
  alertDismissedAt DateTime?

  decidedAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([shopDomain, decidedAt(sort: Desc)])
  @@index([shopifyVariantId, decidedAt(sort: Desc)])
  @@index([shopDomain, appliedAt])
  @@index([shopDomain, alertDismissedAt, decidedAt(sort: Desc)])
}

model PromotionWindow {
  id               String           @id @default(uuid())
  shopDomain       String
  shop             ShopifyUser      @relation(fields: [shopDomain], references: [shopDomain])
  scope            PricingRuleScope @default(SHOP)
  scopeRef         String?
  startsAt         DateTime
  endsAt           DateTime
  pauseAutoPricing Boolean          @default(true)
  note             String?
  createdAt        DateTime         @default(now())

  @@index([shopDomain, startsAt, endsAt])
}

model SalesAggregate {
  shopifyVariantId String         @id
  variant          ShopifyVariant @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)
  shopDomain       String

  orders7d    Int      @default(0)
  revenue7d   Decimal  @default(0) @db.Decimal(12, 2)
  orders28d   Int      @default(0)
  revenue28d  Decimal  @default(0) @db.Decimal(12, 2)
  daysOfStock Decimal? @db.Decimal(8, 2)

  updatedAt DateTime @updatedAt

  @@index([shopDomain])
}

// Long-lived offline access token per shop. Distinct from the Session model,
// which stores online (user-bound) tokens used by Shopify's auth middleware.
model ShopAuth {
  shopDomain         String      @id
  shop               ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])
  offlineAccessToken String
  scopes             String
  installedAt        DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}
