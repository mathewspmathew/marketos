generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Prisma Migrate's schema engine doesn't support running through a
  // connection pooler — this is what `npx prisma migrate ...` uses instead
  // of the pooled `url` above. Bypasses PgBouncer, hits Aiven directly.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pg_trgm, timescaledb, vector]
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        ChatRole
  content     Json
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  tokenCount  Int?
  pinned      Boolean     @default(false)
  ChatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ChatPreview {
  id          String      @id @default(cuid())
  sessionId   String
  shopDomain  String
  kind        PreviewKind
  scopeFilter Json
  change      Json
  variantIds  String[]
  summary     Json
  expiresAt   DateTime    @db.Timestamptz(3)
  appliedAt   DateTime?   @db.Timestamptz(3)
  appliedBy   String?
  result      Json?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  ChatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([shopDomain, expiresAt])
  @@index([sessionId])
}

model ChatSession {
  id                 String        @id @default(cuid())
  shopDomain         String
  userId             String?
  title              String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @db.Timestamptz(3)
  runningSummary     String?
  resolvedProductIds Json          @default("[]")
  ChatMessage        ChatMessage[]
  ChatPreview        ChatPreview[]
  ShopifyUser        ShopifyUser   @relation(fields: [shopDomain], references: [shopDomain])

  @@index([shopDomain, updatedAt])
}

model CompetitorCandidate {
  id               String          @id @default(cuid())
  shopDomain       String
  shopifyProductId String
  discoveryJobId   String?
  url              String
  domain           String
  source           String
  serpTitle        String?
  serpSnippet      String?
  serpPrice        Decimal?        @db.Decimal(10, 2)
  rerankScore      Decimal?        @db.Decimal(4, 3)
  rerankReason     String?
  status           CandidateStatus @default(PENDING)
  rejectReason     String?
  scrapedProductId String?
  discoveredAt     DateTime        @default(now()) @db.Timestamptz(3)
  scrapedAt        DateTime?       @db.Timestamptz(3)
  verifiedAt       DateTime?       @db.Timestamptz(3)
  embedScore       Decimal?        @db.Decimal(5, 4)
  DiscoveryJob     DiscoveryJob?   @relation(fields: [discoveryJobId], references: [id])
  ScrapedProduct   ScrapedProduct? @relation(fields: [scrapedProductId], references: [id])
  ShopifyUser      ShopifyUser     @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyProduct   ShopifyProduct  @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)

  @@unique([shopifyProductId, url])
  @@index([shopDomain, status])
  @@index([scrapedProductId])
}

model CompetitorPriceObservation {
  id                  String
  shopDomain          String
  competitorVariantId String
  price               Decimal        @db.Decimal(10, 2)
  currency            String         @default("INR") @db.VarChar(3)
  isInStock           Boolean        @default(true)
  observedAt          DateTime       @default(now()) @db.Timestamptz(3)
  ScrapedVariant      ScrapedVariant @relation(fields: [competitorVariantId], references: [id], onDelete: Cascade)
  ShopifyUser         ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])

  @@id([id, observedAt])
  @@index([competitorVariantId, observedAt(sort: Desc)])
  @@index([shopDomain, observedAt(sort: Desc)])
}

model DiscoveryJob {
  id                  String                @id @default(cuid())
  shopDomain          String
  shopifyProductId    String
  status              DiscoveryStatus       @default(QUEUED)
  error               String?
  requestedAt         DateTime              @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?             @db.Timestamptz(3)
  query               String?
  CompetitorCandidate CompetitorCandidate[]
  ShopifyUser         ShopifyUser           @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyProduct      ShopifyProduct        @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)

  @@index([shopDomain, status])
  @@index([shopifyProductId, requestedAt(sort: Desc)])
}

model PriceDecision {
  id               String         @id @default(cuid())
  shopDomain       String
  shopifyVariantId String
  oldPrice         Decimal        @db.Decimal(10, 2)
  newPrice         Decimal        @db.Decimal(10, 2)
  reason           String
  decidedAt        DateTime       @default(now()) @db.Timestamptz(3)
  appliedAt        DateTime?      @db.Timestamptz(3)
  shopifyResponse  Json?
  changePct        Float?
  refPrice         Decimal?       @db.Decimal(10, 2)
  formulaTarget    Decimal?       @db.Decimal(10, 2)
  competitorsUsed  Int            @default(0)
  topMatchesJson   Json?
  tierAtDecision   PricingTier?
  skipReason       String?
  autoApplied      Boolean        @default(false)
  applyError       String?
  oosObservations  Int            @default(0)
  currencyDrops    Int            @default(0)
  revertedAt       DateTime?      @db.Timestamptz(3)
  ShopifyUser      ShopifyUser    @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyVariant   ShopifyVariant @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)

  @@index([shopDomain, appliedAt])
  @@index([shopDomain, decidedAt(sort: Desc)])
  @@index([shopifyVariantId, decidedAt(sort: Desc)])
}

model ProductEmbedding {
  id             String                 @id @default(cuid())
  prodId         String
  variantId      String?
  vectorText     Unsupported("vector")?
  vectorImg      Unsupported("vector")?
  vectorizedAt   DateTime               @default(now()) @db.Timestamptz(3)
  shopDomain     String
  matchedAt      DateTime?              @db.Timestamptz(3)
  ScrapedProduct ScrapedProduct         @relation(fields: [prodId], references: [id], onDelete: Cascade)
  ShopifyUser    ShopifyUser            @relation(fields: [shopDomain], references: [shopDomain])
  ScrapedVariant ScrapedVariant?        @relation(fields: [variantId], references: [id])

  @@index([prodId])
}

model ProductLevelMatch {
  id               String              @id @default(cuid())
  shopDomain       String
  shopifyProductId String
  scrapedProductId String
  confidence       Decimal             @db.Decimal(4, 3)
  confidenceTier   MatchConfidenceTier
  source           String              @default("DISCOVERY")
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @db.Timestamptz(3)
  reviewedAt       DateTime?           @db.Timestamptz(3)
  reviewStatus     MatchReviewStatus   @default(PENDING)
  ScrapedProduct   ScrapedProduct      @relation(fields: [scrapedProductId], references: [id], onDelete: Cascade)
  ShopifyUser      ShopifyUser         @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyProduct   ShopifyProduct      @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)
  ProductMatch     ProductMatch[]

  @@unique([shopifyProductId, scrapedProductId])
  @@index([shopDomain, confidenceTier])
  @@index([shopDomain, reviewedAt])
  @@index([scrapedProductId])
}

model ProductMatch {
  id                  String               @id @default(cuid())
  shopDomain          String
  shopifyVariantId    String
  competitorVariantId String?
  competitorProdId    String
  matchScore          Decimal              @db.Decimal(5, 2)
  matchType           String               @default("semantic")
  vectorDistance      Decimal              @db.Decimal(10, 6)
  thresholdUsed       Decimal              @db.Decimal(5, 4)
  matchedAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @db.Timestamptz(3)
  textScore           Decimal?             @db.Decimal(5, 2)
  imageScore          Decimal?             @db.Decimal(5, 2)
  confidence          Decimal?             @db.Decimal(4, 3)
  confidenceTier      MatchConfidenceTier?
  dismissedAt         DateTime?            @db.Timestamptz(3)
  productMatchId      String?
  currencyMismatch    Boolean              @default(false)
  ScrapedProduct      ScrapedProduct       @relation(fields: [competitorProdId], references: [id], onDelete: Cascade)
  ScrapedVariant      ScrapedVariant?      @relation(fields: [competitorVariantId], references: [id])
  ProductLevelMatch   ProductLevelMatch?   @relation(fields: [productMatchId], references: [id])
  ShopifyUser         ShopifyUser          @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyVariant      ShopifyVariant       @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)

  @@unique([shopifyVariantId, competitorVariantId])
  @@index([competitorVariantId], map: "idx_pm_competitor")
  @@index([shopDomain, dismissedAt], map: "idx_pm_shop_dismissed")
  @@index([shopDomain, matchScore(sort: Desc)], map: "idx_pm_shop_domain")
  @@index([shopifyVariantId, matchScore(sort: Desc)], map: "idx_pm_shopify")
  @@index([competitorProdId])
  @@index([productMatchId])
}

model ProductUrl {
  id               String          @id @default(cuid())
  configId         String?
  prodId           String
  url              String
  status           UrlStatus       @default(ACTIVE)
  failCount        Int             @default(0)
  lastScrapedAt    DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  shopDomain       String
  nextRunAt        DateTime?       @db.Timestamptz(3)
  shopifyProductId String?
  ScrapingConfig   ScrapingConfig? @relation(fields: [configId], references: [id])
  ScrapedProduct   ScrapedProduct  @relation(fields: [prodId], references: [id], onDelete: Cascade)
  ShopifyUser      ShopifyUser     @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyProduct   ShopifyProduct? @relation(fields: [shopifyProductId], references: [id], onDelete: Cascade)

  @@unique([shopifyProductId, url])
  @@index([shopDomain, status, nextRunAt])
  @@index([shopifyProductId])
  @@index([prodId])
}

model ScrapedProduct {
  id                  String                @id @default(cuid())
  domain              String
  title               String
  description         String?
  vendor              String?
  productType         String?
  tags                Json                  @default("[]")
  imageUrl            String?
  specifications      Json?
  updatedAt           DateTime              @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  shopDomain          String
  categoryTop         String?
  productGender       String?
  CompetitorCandidate CompetitorCandidate[]
  ProductEmbedding    ProductEmbedding[]
  ProductLevelMatch   ProductLevelMatch[]
  ProductMatch        ProductMatch[]
  ProductUrl          ProductUrl[]
  ShopifyUser         ShopifyUser           @relation(fields: [shopDomain], references: [shopDomain])
  ScrapedVariant      ScrapedVariant[]
}

model ScrapedVariant {
  id                         String                       @id @default(cuid())
  productId                  String
  sku                        String?
  barcode                    String?
  title                      String                       @default("Default Title")
  options                    Json?
  currentPrice               Decimal                      @db.Decimal(10, 2)
  originalPrice              Decimal?                     @db.Decimal(10, 2)
  isInStock                  Boolean                      @default(true)
  stockQuantity              Int?
  updatedAt                  DateTime                     @db.Timestamptz(3)
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(3)
  semanticText               String?
  currency                   String                       @default("INR") @db.VarChar(3)
  CompetitorPriceObservation CompetitorPriceObservation[]
  ProductEmbedding           ProductEmbedding[]
  ProductMatch               ProductMatch[]
  ScrapedProduct             ScrapedProduct               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ScrapingConfig {
  id                String       @id @default(cuid())
  competitorUrl     String
  includeImages     Boolean      @default(true)
  productLimit      Int?
  frequencyInterval Int?
  nextRunAt         DateTime?    @db.Timestamptz(3)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @db.Timestamptz(3)
  status            ScrapeStatus @default(IDLE)
  shopDomain        String
  frequencyUnit     String?      @default("nofreq")
  ProductUrl        ProductUrl[]
  ShopifyUser       ShopifyUser  @relation(fields: [shopDomain], references: [shopDomain])
}

model Session {
  id                  String    @id @default(cuid())
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime? @db.Timestamptz(3)
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime? @db.Timestamptz(3)
}

model ShopSettings {
  shopDomain               String      @id
  markupPct                Decimal     @default(0.02) @db.Decimal(5, 4)
  marketplaceBlocklist     String[]    @default([])
  updatedAt                DateTime    @db.Timestamptz(3)
  frequencyInterval        Int         @default(1)
  frequencyUnit            String      @default("day")
  defaultPricingTier       PricingTier @default(COMPETITIVE)
  maxCompetitorsPerProduct Int         @default(8)
  listingExpansionCap      Int?
  serperGl                 String      @default("in")
  serperHl                 String      @default("en")
  serperLocation           String      @default("Kochi, Kerala")
  currency                 String?
  autoRescrapeEnabled      Boolean     @default(true)
  minCompetitorsToPrice    Int         @default(4)
  topKCompetitors          Int         @default(4)
  maxAutoApplyChangePct    Float       @default(0.05)
  lifetimeCapPct           Float       @default(0.25)
  budgetUndercut           Float       @default(0.05)
  premiumUplift            Float       @default(0.05)
  includeOosInPricing      Boolean     @default(false)
  autoUpdatePriceEnabled   Boolean     @default(true)
  discoveryNumResults      Int         @default(10)
  minChangePctThreshold    Float       @default(0.005)
  minFreshnessHours        Int         @default(24)
  notifyEmail                     String?
  priceChangeNotificationsEnabled Boolean     @default(false)
  ShopifyUser              ShopifyUser @relation(fields: [shopDomain], references: [shopDomain])
}

model ShopifyEmbedding {
  id             String                 @id @default(cuid())
  variantId      String                 @unique
  vectorText     Unsupported("vector")?
  vectorImg      Unsupported("vector")?
  embeddedAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @db.Timestamptz(3)
  shopDomain     String
  matchedAt      DateTime?              @db.Timestamptz(3)
  ShopifyVariant ShopifyVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopDomain])
}

model ShopifyProduct {
  id                            String                @id @default(cuid())
  title                         String
  description                   String                @default("")
  vendor                        String?
  productType                   String                @default("")
  tags                          Json                  @default("[]")
  imageUrl                      String?
  status                        String                @default("ACTIVE")
  createdAt                     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime              @db.Timestamptz(3)
  dynamicPricingEnabled         Boolean               @default(false)
  dynamicPricingConfiguredAt    DateTime?             @db.Timestamptz(3)
  handle                        String?
  shopDomain                    String
  syncPrice                     Boolean               @default(true)
  categoryTop                   String?
  productGender                 String?
  lastDiscoveryAt               DateTime?             @db.Timestamptz(3)
  searchQuery                   String?
  frequencyInterval             Int?
  frequencyUnit                 String?
  searchQueryOverride           String?
  discoveryNumResults           Int?
  lastDiscoveryNumResults       Int?
  listingExpansionCap           Int?
  pricingTier                   PricingTier           @default(COMPETITIVE)
  avgBasePrice                  Decimal?              @db.Decimal(10, 2)
  minPriceOverride              Decimal?              @db.Decimal(10, 2)
  maxPriceOverride              Decimal?              @db.Decimal(10, 2)
  maxAutoApplyChangePctOverride Float?
  lifetimeCapPctOverride        Float?
  lastDecisionAt                DateTime?             @db.Timestamptz(3)
  semanticStatus                String                @default("PENDING")
  semanticClaimedAt             DateTime?             @db.Timestamptz(3)
  semanticVersion               Int                   @default(0)
  semanticAttempts              Int                   @default(0)
  semanticFailureReason         String?
  CompetitorCandidate           CompetitorCandidate[]
  DiscoveryJob                  DiscoveryJob[]
  ProductLevelMatch             ProductLevelMatch[]
  ProductUrl                    ProductUrl[]
  ShopifyUser                   ShopifyUser           @relation(fields: [shopDomain], references: [shopDomain])
  ShopifyVariant                ShopifyVariant[]

  @@index([shopDomain, updatedAt])
}

model ShopifyUser {
  shopDomain                 String                       @id
  shopifyUserId              BigInt?
  email                      String?
  firstName                  String?
  installedAt                DateTime                     @default(now()) @db.Timestamptz(3)
  productSyncState           String                       @default("IDLE")
  productSyncStartedAt       DateTime?                    @db.Timestamptz(3)
  productSyncedAt            DateTime?                    @db.Timestamptz(3)
  productSyncError           String?
  ChatSession                ChatSession[]
  CompetitorCandidate        CompetitorCandidate[]
  CompetitorPriceObservation CompetitorPriceObservation[]
  DiscoveryJob               DiscoveryJob[]
  PriceDecision              PriceDecision[]
  ProductEmbedding           ProductEmbedding[]
  ProductLevelMatch          ProductLevelMatch[]
  ProductMatch               ProductMatch[]
  ProductUrl                 ProductUrl[]
  ScrapedProduct             ScrapedProduct[]
  ScrapingConfig             ScrapingConfig[]
  ShopSettings               ShopSettings?
  ShopifyProduct             ShopifyProduct[]
}

model ShopifyVariant {
  id                     String                  @id @default(cuid())
  productId              String
  sku                    String?
  barcode                String?
  title                  String                  @default("Default Title")
  options                Json?
  currentPrice           Decimal                 @db.Decimal(10, 2)
  isInStock              Boolean                 @default(true)
  stockQuantity          Int?
  updatedAt              DateTime                @db.Timestamptz(3)
  compareAtPrice         Decimal?                @db.Decimal(10, 2)
  imageUrl               String?
  semanticText           String?
  cost                   Decimal?                @db.Decimal(10, 2)
  inventoryQuantity      Int?
  basePrice              Decimal?                @db.Decimal(10, 2)
  PriceDecision          PriceDecision[]
  ProductMatch           ProductMatch[]
  ShopifyEmbedding       ShopifyEmbedding?
  ShopifyProduct         ShopifyProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  VariantCompetitorStats VariantCompetitorStats?

  @@index([productId])
}

model VariantCompetitorStats {
  shopifyVariantId String         @id
  shopDomain       String
  competitorCount  Int            @default(0)
  minPrice         Decimal?       @db.Decimal(10, 2)
  median           Decimal?       @db.Decimal(10, 2)
  maxPrice         Decimal?       @db.Decimal(10, 2)
  lastUpdatedAt    DateTime       @default(now()) @db.Timestamptz(3)
  ShopifyVariant   ShopifyVariant @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)

  @@index([shopDomain])
}

enum CandidateStatus {
  PENDING
  SCRAPED
  VERIFIED
  REJECTED
  DEAD
}

enum ChatRole {
  user
  assistant
  tool
}

enum DiscoveryStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum MatchConfidenceTier {
  CONFIRMED
  LIKELY
  WEAK
}

enum MatchReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PreviewKind {
  price_change
  dynamic_pricing_toggle
}

enum PricingTier {
  BUDGET
  COMPETITIVE
  PREMIUM
}

enum ScrapeStatus {
  IDLE
  QUEUED
  RUNNING
  SCRAPED_FIRST
}

enum UrlStatus {
  ACTIVE
  DEAD
  PAUSED
}
