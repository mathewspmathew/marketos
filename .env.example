# MarketOS environment variables — copy to .env and fill in real values.

# Database + queue
# DATABASE_URL: used as-is by host-run processes (uv run celery/uvicorn, npm
# run dev) — connects straight to Postgres.
DATABASE_URL=postgresql://user:pass@localhost:5432/marketos
# DIRECT_DATABASE_URL: same target as DATABASE_URL. Used inside docker-compose
# by the two paths that must bypass PgBouncer — live_updates.py's LISTEN/NOTIFY
# connection (session-scoped, incompatible with transaction pooling) and
# Prisma Migrate's directUrl (its schema engine doesn't support a pooler).
DIRECT_DATABASE_URL=postgresql://user:pass@localhost:5432/marketos
# PGBOUNCER_UPSTREAM_URL: same target again, no query string — PgBouncer's own
# config parser can't handle e.g. "?sslmode=require" in the database-name slot;
# set TLS via SERVER_TLS_SSLMODE in docker-compose.yml's pgbouncer service instead.
PGBOUNCER_UPSTREAM_URL=postgresql://user:pass@localhost:5432/marketos
# PGBOUNCER_DATABASE_URL: what docker-compose services use as DATABASE_URL —
# routes through the local pgbouncer container instead of hitting Postgres
# directly from every worker/process.
PGBOUNCER_DATABASE_URL=postgresql://user:pass@pgbouncer:6432/marketos?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Scraping + extraction
FIRECRAWL_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_CANDIDATE=
GROQ_API_KEY_SEMANTIC=
GROQ_API_KEY_SHOPIFY=
GROQ_API_KEY_CHATBOT=
SERPER_API_KEY=

# GCS
GCS_IMAGE_BUCKET=
GCS_MARKDOWN_BUCKET=

# Vertex AI (embeddings)
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini (used alongside/instead of Vertex in some paths)
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Shopify app
APP_URL=http://localhost:3000
INTERNAL_API_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=

# Resend (transactional email — price-change notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Chatbot service
CHATBOT_MODEL=groq:llama-3.3-70b-versatile
# Comma-separated, tried in order if the model before it fails (429/5xx).
# Groq tracks quota per exact model string, so pick fallbacks you're not
# already spending quota on elsewhere.
CHATBOT_FALLBACK_MODEL=groq:openai/gpt-oss-120b,groq:llama-3.1-8b-instant
CHATBOT_SVC_URL=http://localhost:8088
CHATBOT_RR_URL=http://localhost:3000
# Used by the eval harness only, not the running chatbot service.
CHATBOT_EVAL_MODEL=
CHATBOT_EVAL_FALLBACK_MODEL=

# Observability + misc
LOGFIRE_TOKEN=
# sentry.io project DSN (Python platform). Leave blank to disable — every
# service is a no-op without it (see services/common/logging_config.py).
SENTRY_DSN=
# Flower (Celery monitoring dashboard, prod only) has no auth of its own —
# required in docker-compose.prod.yml's flower service. user:pass format.
FLOWER_BASIC_AUTH=
MARKETOS_DEMO_TENANT_ID=
# Set to enable verbose prisma-client-py generator logging; leave unset normally.
PRISMA_PY_DEBUG_GENERATOR=
